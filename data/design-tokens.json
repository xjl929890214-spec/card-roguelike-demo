{
  "_comment": "视觉规范令牌(Design Tokens)。分支1 CSS 里的所有 color/size/spacing 值都从这里取，便于全局换肤。",
  "_usage_for_branch1": "在 style.css 顶部 :root { --color-bg: #...; } 用这里的 token 名做映射",

  "colors": {
    "bg": {
      "primary":   "#1A1F2E",
      "secondary": "#2A3142",
      "surface":   "#3B4356",
      "overlay":   "rgba(0, 0, 0, 0.6)"
    },
    "text": {
      "primary":   "#F5F5F5",
      "secondary": "#9CA3AF",
      "muted":     "#6B7280",
      "inverse":   "#1A1F2E"
    },
    "brand": {
      "red":       "#FE5F55",
      "blue":      "#3B82F6",
      "yellow":    "#FCD34D",
      "green":     "#10B981",
      "purple":    "#A855F7"
    },
    "game": {
      "chips_blue":  "#5B92E5",
      "mult_red":    "#FE5F55",
      "x_mult_pink": "#F472B6",
      "money_gold":  "#FBBF24",
      "hand_white":  "#F5F5F5"
    },
    "rarity": {
      "common":    "#9CA3AF",
      "uncommon":  "#3B82F6",
      "rare":      "#EF4444",
      "legendary": "#A855F7"
    },
    "suit": {
      "spade":   "#1F2937",
      "club":    "#1F2937",
      "heart":   "#DC2626",
      "diamond": "#DC2626"
    },
    "blind": {
      "small":  "#3B82F6",
      "big":    "#F59E0B",
      "boss":   "#EF4444"
    },
    "status": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger":  "#EF4444",
      "info":    "#3B82F6"
    },
    "border": {
      "card":    "#FFFFFF",
      "panel":   "#4B5563",
      "active":  "#FCD34D",
      "hover":   "#F5F5F5"
    }
  },

  "typography": {
    "font_family": {
      "display":  "'Press Start 2P', monospace",
      "ui":       "'VT323', monospace",
      "fallback": "system-ui, -apple-system, sans-serif"
    },
    "size_px": {
      "xs":   10,
      "sm":   12,
      "base": 14,
      "md":   16,
      "lg":   20,
      "xl":   28,
      "2xl":  36,
      "3xl":  48,
      "logo": 72
    },
    "line_height": {
      "tight":  1.2,
      "normal": 1.4,
      "loose":  1.6
    },
    "letter_spacing_em": {
      "tight":  -0.02,
      "normal": 0,
      "wide":   0.1
    }
  },

  "spacing_px": {
    "0":   0,
    "1":   2,
    "2":   4,
    "3":   8,
    "4":   12,
    "5":   16,
    "6":   24,
    "7":   32,
    "8":   48,
    "9":   64,
    "10":  96
  },

  "radius_px": {
    "sm":   4,
    "card": 6,
    "md":   8,
    "panel":12,
    "lg":   16,
    "pill": 999
  },

  "shadow": {
    "card":  "0 2px 4px rgba(0,0,0,0.4)",
    "card_hover": "0 4px 12px rgba(0,0,0,0.5)",
    "panel": "0 4px 16px rgba(0,0,0,0.3)",
    "popup": "0 8px 24px rgba(0,0,0,0.6)",
    "inner": "inset 0 1px 2px rgba(0,0,0,0.3)",
    "glow_yellow": "0 0 12px rgba(252,211,77,0.6)",
    "glow_red":    "0 0 12px rgba(254,95,85,0.6)"
  },

  "border_width_px": {
    "thin":   1,
    "card":   2,
    "panel":  3,
    "thick":  4
  },

  "sizes": {
    "card": {
      "width":  71,
      "height": 95,
      "small_width":  48,
      "small_height": 64
    },
    "joker": {
      "width":  71,
      "height": 95
    },
    "button": {
      "height_sm": 32,
      "height_md": 44,
      "height_lg": 56
    },
    "panel": {
      "side_min_width": 200,
      "hud_height":     80
    },
    "viewport": {
      "design_width":  1280,
      "design_height": 800
    }
  },

  "z_index": {
    "background": 0,
    "panel":      10,
    "card":       20,
    "card_drag":  30,
    "popup":      40,
    "modal":      50,
    "tooltip":    60,
    "toast":      70
  },

  "opacity": {
    "disabled":     0.4,
    "ghost":        0.6,
    "active":       1.0,
    "panel_bg":     0.92
  },

  "easing": {
    "default":  "cubic-bezier(0.22, 1, 0.36, 1)",
    "in_out":   "ease-in-out",
    "out":      "ease-out",
    "punch":    "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },

  "breakpoints_px": {
    "mobile":  480,
    "tablet":  768,
    "desktop": 1024,
    "wide":    1440
  }
}
