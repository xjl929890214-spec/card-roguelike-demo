{
  "_comment": "动画时间轴规范。所有时间单位毫秒(ms)。easing用CSS标准缓动函数名。",
  "_branch1_usage": "分支1做动画时直接照这里的数值写transition/keyframes",

  "card_select": {
    "_desc": "玩家点击手牌，被选中的牌向上抬起",
    "lift_distance_px": 24,
    "duration_ms": 120,
    "easing": "ease-out"
  },

  "card_play": {
    "_desc": "出牌：选中的牌从手牌区飞到出牌区",
    "fly_duration_ms": 300,
    "stagger_between_cards_ms": 80,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "fly_arc_height_px": 40
  },

  "card_flip": {
    "_desc": "翻牌(从背面翻到正面)，逐张触发",
    "duration_ms": 200,
    "stagger_ms": 100,
    "easing": "ease-in-out"
  },

  "chip_popup": {
    "_desc": "每张计分牌弹出蓝色筹码数字",
    "appear_ms": 150,
    "stay_ms": 400,
    "fade_ms": 200,
    "rise_distance_px": 30,
    "color_hex": "#3B82F6",
    "font_size_px": 28,
    "easing": "ease-out"
  },

  "mult_popup": {
    "_desc": "倍率累加时弹出红色 ×N 数字",
    "appear_ms": 150,
    "stay_ms": 400,
    "fade_ms": 200,
    "rise_distance_px": 30,
    "color_hex": "#EF4444",
    "font_size_px": 28,
    "scale_punch": 1.3,
    "easing": "ease-out"
  },

  "score_counter": {
    "_desc": "底部主分数从0滚动到最终分数",
    "duration_ms": 800,
    "easing": "ease-out",
    "_note": "用requestAnimationFrame插值，每30ms更新一次显示数字"
  },

  "joker_trigger": {
    "_desc": "Joker被触发时卡牌震动一下并发光",
    "shake_amplitude_px": 4,
    "shake_duration_ms": 200,
    "glow_color_hex": "#FCD34D",
    "glow_duration_ms": 300
  },

  "blind_defeat": {
    "_desc": "击败盲注的胜利动画",
    "screen_flash_ms": 150,
    "flash_color_hex": "#FCD34D",
    "text_zoom_in_ms": 400,
    "text_stay_ms": 800,
    "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },

  "shop_card_appear": {
    "_desc": "商店刷新时Joker卡从下往上滑入",
    "duration_ms": 250,
    "stagger_ms": 60,
    "slide_distance_px": 50,
    "easing": "ease-out"
  },

  "money_gain": {
    "_desc": "获得金币时金币图标飘到右上角金币显示处",
    "fly_duration_ms": 500,
    "stagger_ms": 50,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },

  "global": {
    "default_button_hover_ms": 120,
    "default_panel_fade_ms": 200,
    "scene_transition_ms": 300
  }
}
